#!/usr/bin/env bash
# mise-tasks/test — end-to-end smoke test for the truebrew backend plugin.
# Usage: ./mise-tasks/test  (or: mise run test)
set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "== truebrew e2e =="
echo "plugin: $PLUGIN_DIR"

echo "-- search cache regression --"
python3 "$PLUGIN_DIR/tests/search_cache.py"

mise plugin link --force truebrew "$PLUGIN_DIR"

echo "-- ls-remote truebrew:jq --"
mise ls-remote truebrew:jq

echo "-- install truebrew:jq --"
mise install truebrew:jq@latest

echo "-- exec jq --version --"
mise exec truebrew:jq@latest -- jq --version
echo '{"hello":"world"}' | mise exec truebrew:jq@latest -- jq .hello

echo "-- install truebrew:ripgrep (dep: pcre2) --"
mise install truebrew:ripgrep@latest
mise exec truebrew:ripgrep@latest -- rg --version

echo "-- install truebrew:ncdu (dep: ncurses) --"
mise install truebrew:ncdu@latest
# Unlike --version, infocmp actually loads a terminal description through the
# dependency's ncurses library. Test with no inherited database configuration.
mise cache clear truebrew:ncdu
env -u TERMINFO -u TERMINFO_DIRS mise exec truebrew:ncdu@latest -- sh -c \
    '"$(dirname "$TRUEBREW_OPT_NCDU")/ncurses/bin/infocmp" xterm-256color >/dev/null'
# A user-supplied search path must remain usable alongside truebrew's database.
# mise caches hook results, so refresh between distinct input environments.
mise cache clear truebrew:ncdu
env -u TERMINFO TERMINFO_DIRS=/nonexistent/custom-terminfo mise exec truebrew:ncdu@latest -- sh -c \
    'case "$TERMINFO_DIRS" in /nonexistent/custom-terminfo:*) ;; *) exit 1 ;; esac; "$(dirname "$TRUEBREW_OPT_NCDU")/ncurses/bin/infocmp" xterm-256color >/dev/null'
mise cache clear truebrew:ncdu

echo "-- ncurses launcher with a sudo-like environment --"
mise install --force truebrew:ncurses@latest
ncurses_install="$(mise where truebrew:ncurses@latest)"
# Run directly, bypassing mise's environment hook as sudo does.
env -u TERMINFO -u TERMINFO_DIRS "$ncurses_install/bin/infocmp" xterm-256color >/dev/null
env -u TERMINFO TERMINFO_DIRS=/nonexistent/custom-terminfo \
    "$ncurses_install/bin/infocmp" xterm-256color >/dev/null

echo "OK"
